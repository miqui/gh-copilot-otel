{
  "displayName": "Copilot CLI usage and performance",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Input token rate (usage, not billing)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_request_model, gen_ai_operation_name) (rate(gen_ai_client_inference_usage_input_tokens_total{job=\"github-copilot\"}[5m]))",
                  "unitOverride": "{token}/s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "${gen_ai_request_model} / ${gen_ai_operation_name}"
              }
            ],
            "yAxis": {"label": "Tokens / second", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Output token rate (usage, not billing)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_request_model, gen_ai_operation_name) (rate(gen_ai_client_inference_usage_output_tokens_total{job=\"github-copilot\"}[5m]))",
                  "unitOverride": "{token}/s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "${gen_ai_request_model} / ${gen_ai_operation_name}"
              }
            ],
            "yAxis": {"label": "Tokens / second", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Cache-read input token rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_request_model, gen_ai_operation_name) (rate(gen_ai_client_inference_usage_cache_read_input_tokens_total{job=\"github-copilot\"}[5m]))",
                  "unitOverride": "{token}/s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "${gen_ai_request_model} / ${gen_ai_operation_name}"
              }
            ],
            "yAxis": {"label": "Tokens / second", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Cache-write input token rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_request_model, gen_ai_operation_name) (rate(gen_ai_client_inference_usage_cache_write_input_tokens_total{job=\"github-copilot\"}[5m]))",
                  "unitOverride": "{token}/s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "${gen_ai_request_model} / ${gen_ai_operation_name}"
              }
            ],
            "yAxis": {"label": "Tokens / second", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Model operation latency (p50 / p95 / p99)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (le, gen_ai_request_model, gen_ai_operation_name) (rate(gen_ai_client_operation_duration_seconds_bucket{job=\"github-copilot\"}[5m])))",
                  "unitOverride": "s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p50 ${gen_ai_request_model} / ${gen_ai_operation_name}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, gen_ai_request_model, gen_ai_operation_name) (rate(gen_ai_client_operation_duration_seconds_bucket{job=\"github-copilot\"}[5m])))",
                  "unitOverride": "s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p95 ${gen_ai_request_model} / ${gen_ai_operation_name}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le, gen_ai_request_model, gen_ai_operation_name) (rate(gen_ai_client_operation_duration_seconds_bucket{job=\"github-copilot\"}[5m])))",
                  "unitOverride": "s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p99 ${gen_ai_request_model} / ${gen_ai_operation_name}"
              }
            ],
            "yAxis": {"label": "Seconds", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Tool call rate",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (gen_ai_tool_name) (rate(github_copilot_tool_call_count_total{job=\"github-copilot\"}[5m]))",
                  "unitOverride": "{call}/s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "${gen_ai_tool_name}"
              }
            ],
            "yAxis": {"label": "Calls / second", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 12,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "Tool call duration (p50 / p95 / p99)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (le, gen_ai_tool_name) (rate(github_copilot_tool_call_duration_seconds_bucket{job=\"github-copilot\"}[5m])))",
                  "unitOverride": "s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p50 ${gen_ai_tool_name}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, gen_ai_tool_name) (rate(github_copilot_tool_call_duration_seconds_bucket{job=\"github-copilot\"}[5m])))",
                  "unitOverride": "s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p95 ${gen_ai_tool_name}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le, gen_ai_tool_name) (rate(github_copilot_tool_call_duration_seconds_bucket{job=\"github-copilot\"}[5m])))",
                  "unitOverride": "s",
                  "outputFullDuration": false
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p99 ${gen_ai_tool_name}"
              }
            ],
            "yAxis": {"label": "Seconds", "scale": "LINEAR"}
          }
        }
      }
    ]
  }
}
